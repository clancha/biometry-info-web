---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
}

const { eyebrow, title, subtitle, align = "left" } = Astro.props;
---

<header class={`section-header ${align === "center" ? "is-centered" : ""}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</header>
