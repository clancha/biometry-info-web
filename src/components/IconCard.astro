  ticket: `<rect x="5" y="9" width="22" height="14" rx="3"></rect><path d="M12 9v14"></path><circle cx="12" cy="13" r="1"></circle><circle cx="12" cy="19" r="1"></circle>`,
  market: `<path d="M4 13h24"></path><path d="M7 13l2 13h14l2-13"></path><path d="M8 13l2-7h12l2 7"></path>`,
  wallet: `<rect x="4" y="9" width="24" height="15" rx="3"></rect><path d="M18 16h9"></path><circle cx="21.5" cy="16" r="1"></circle>`,
