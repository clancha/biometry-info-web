  trust: `<circle cx="16" cy="16" r="11"></circle><path d="M16 9v7l5 3"></path>`,
  privacy: `<path d="M16 4l10 4v7.8c0 5.6-4.1 9.2-10 12.2-5.9-3-10-6.6-10-12.2V8z"></path><circle cx="16" cy="15" r="2"></circle><path d="M16 17v3"></path>`,
