};

const iconMarkup = icons[icon] ?? icons.shield;
---

<article class={`icon-card icon-card--${variant}`}>
  <div class="icon-badge" aria-hidden="true">
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconMarkup}></svg>
  </div>
  <h3>{title}</h3>
  <p>{text}</p>
</article>
