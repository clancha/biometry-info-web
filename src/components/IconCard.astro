  tee: `<rect x="6" y="6" width="20" height="20" rx="4"></rect><rect x="11" y="11" width="10" height="10" rx="2"></rect><path d="M16 2v4M16 26v4M2 16h4M26 16h4M6 6l-3-3M26 6l3-3M6 26l-3 3M26 26l3 3"></path>`,
  antiFraud: `<path d="M5 7h22"></path><path d="M7 7l3 18h12l3-18"></path><path d="M12 12l8 8"></path><path d="M20 12l-8 8"></path>`,
