---
export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang === "en" ? "en" : "es";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>veriq</title>
    <meta http-equiv="refresh" content={`0;url=/veriq/${lang}`} />
  </head>
  <body>
    <p>Redirigiendo a <a href={`/veriq/${lang}`}>/veriq/{lang}</a>...</p>
  </body>
</html>
