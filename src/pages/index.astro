---
import SectionHeader from "../components/SectionHeader.astro";
import IconCard from "../components/IconCard.astro";
import StepCard from "../components/StepCard.astro";

const problemItems = [
  {
    icon: "bot",
    title: "Bots",
    text: "Automated traffic mimics real users at scale.",
  },
  {
    icon: "fake",
    title: "Fake accounts",
    text: "Synthetic profiles bypass basic verification.",
  },
  {
    icon: "takeover",
    title: "Account takeovers",
    text: "Stolen credentials unlock trusted accounts.",
  },
  {
    icon: "fraud",
    title: "Identity fraud",
    text: "Impersonation drives financial and trust loss.",
  },
];

const solutionItems = [
  {
    icon: "user",
    title: "Verify real users",
    text: "Confirm that a real person is behind each action.",
  },
  {
    icon: "shield",
    title: "Stop automated abuse",
    text: "Block bots, replay attacks and spoofing attempts.",
  },
  {
    icon: "biometric",
    title: "Add secure biometrics",
    text: "Use biometric auth with liveness in one flow.",
  },
];

const steps = [
  {
    title: "User starts action",
    text: "A login, transfer, signup or sensitive operation begins.",
  },
  {
    title: "Biometric check runs",
    text: "Identity and liveness are verified in real time.",
  },
  {
    title: "Proof is returned",
    text: "Your platform receives proof of identity and humanity.",
  },
];

const useCases = [
  {
    icon: "ticket",
    title: "Ticketing",
    text: "Protect access and reduce resale abuse.",
  },
  {
    icon: "market",
    title: "Marketplaces",
    text: "Prevent fake sellers and fraudulent activity.",
  },
  {
    icon: "wallet",
    title: "Digital wallets",
    text: "Secure account access and sensitive transactions.",
  },
  {
    icon: "bank",
    title: "Banking",
    text: "Strengthen onboarding and account recovery.",
  },
  {
    icon: "social",
    title: "Social platforms",
    text: "Limit bots and fake engagement.",
  },
  {
    icon: "trust",
    title: "High-trust apps",
    text: "Build confidence in every user action.",
  },
];

const whyUs = [
  {
    icon: "privacy",
    title: "Privacy-preserving",
    text: "Security without exposing unnecessary user data.",
  },
  {
    icon: "quantum",
    title: "Post-quantum protection",
    text: "Biometric templates protected with post-quantum cryptography.",
  },
  {
    icon: "openid",
    title: "OpenID-compatible",
    text: "Aligned with OpenID/OIDC identity schemes.",
  },
  {
    icon: "tee",
    title: "Trusted Execution Environment",
    text: "Verification workloads run inside TEE-protected runtime.",
  },
  {
    icon: "antiFraud",
    title: "Anti-bot and anti-fraud",
    text: "Reduce automated abuse and impersonation risk.",
  },
  {
    icon: "api",
    title: "Modern API / SDK approach",
    text: "Composable integration across apps and services.",
  },
];

const devStack = [
  "iOS SDK",
  "Android SDK",
  "Web integration",
  "OpenID / OIDC compatible",
  "API-first",
  "TEE-ready deployment",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Biometric Trust | Prove Identity. Prove Humanity.</title>
    <meta
      name="description"
      content="Biometric proof of identity and humanity. Stop bots, fraud and impersonation with a clean API-first authentication layer."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Sora:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #f3f7fb;
        --surface: #ffffff;
        --surface-soft: #f8fbff;
        --ink: #0d1b2a;
        --muted: #54657a;
        --line: #d6e0eb;
        --primary: #0e6fff;
        --primary-dark: #0a4bb0;
        --primary-soft: #eaf2ff;
        --mint-soft: #e8faf4;
        --radius-lg: 1.25rem;
        --radius-md: 0.95rem;
        --shadow: 0 12px 26px rgba(12, 40, 82, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        font-family: "Manrope", "Avenir Next", "Segoe UI", sans-serif;
        color: var(--ink);
        background:
          radial-gradient(60rem 30rem at 10% -10%, #dce8f83f 0%, transparent 60%),
          radial-gradient(55rem 30rem at 100% 0%, #d6f6ed66 0%, transparent 58%),
          var(--bg);
      }

      h1,
      h2,
      h3,
      .brand,
      .btn {
        font-family: "Sora", "Avenir Next", sans-serif;
        letter-spacing: -0.01em;
      }

      .container {
        width: min(1120px, 92vw);
        margin-inline: auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        backdrop-filter: blur(8px);
        background: #f3f7fbd1;
        border-bottom: 1px solid var(--line);
      }

      .header-wrap {
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .brand {
        font-size: 1.02rem;
        font-weight: 700;
      }

      .header-nav {
        display: flex;
        align-items: center;
        gap: 0.9rem;
      }

      .header-nav a {
        text-decoration: none;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 700;
      }

      .section {
        padding: clamp(4.5rem, 8vw, 7rem) 0;
      }

      .hero {
        padding-top: clamp(4.5rem, 8vw, 7rem);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 2rem;
        align-items: center;
      }

      .eyebrow {
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 800;
        font-size: 0.77rem;
        color: var(--primary-dark);
      }

      .hero h1 {
        margin: 0.9rem 0 1rem;
        font-size: clamp(2rem, 5.2vw, 4.1rem);
        line-height: 1.03;
        max-width: 11ch;
      }

      .hero-subtitle {
        margin: 0;
        max-width: 44ch;
        color: var(--muted);
        font-size: clamp(1rem, 1.8vw, 1.18rem);
        line-height: 1.6;
      }

      .hero-actions {
        margin-top: 1.8rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        border-radius: 0.85rem;
        padding: 0.7rem 1rem;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 700;
        border: 1px solid transparent;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-primary {
        background: var(--primary);
        color: #fff;
        box-shadow: 0 8px 18px rgba(14, 111, 255, 0.3);
      }

      .btn-primary:hover {
        background: #005feb;
      }

      .btn-secondary {
        background: var(--surface);
        color: var(--ink);
        border-color: var(--line);
      }

      .trust-pills {
        margin-top: 1.35rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .pill {
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--surface);
        padding: 0.35rem 0.65rem;
        font-size: 0.76rem;
        color: #2e425c;
        font-weight: 700;
      }

      .hero-visual {
        border: 1px solid #bfd3ea;
        border-radius: 1.4rem;
        background:
          radial-gradient(circle at 20% 20%, #eff5ff 0%, transparent 42%),
          radial-gradient(circle at 85% 30%, #e8f9f2 0%, transparent 44%),
          linear-gradient(150deg, #ffffff 0%, #f4f8ff 100%);
        box-shadow: var(--shadow);
        min-height: 400px;
        display: grid;
        place-items: center;
        position: relative;
        overflow: hidden;
      }

      .hero-visual::before,
      .hero-visual::after {
        content: "";
        position: absolute;
        border-radius: 999px;
        border: 1px solid #d6e7ff;
      }

      .hero-visual::before {
        width: 220px;
        height: 220px;
        right: -64px;
        top: -64px;
      }

      .hero-visual::after {
        width: 180px;
        height: 180px;
        left: -58px;
        bottom: -58px;
      }

      .hero-visual svg {
        width: min(460px, 92%);
        height: auto;
      }

      .section-header {
        display: grid;
        gap: 0.65rem;
        margin-bottom: 1.6rem;
      }

      .section-header h2 {
        margin: 0;
        max-width: 18ch;
        font-size: clamp(1.6rem, 3.8vw, 2.8rem);
        line-height: 1.12;
      }

      .section-header .subtitle {
        margin: 0;
        color: var(--muted);
        max-width: 58ch;
        line-height: 1.58;
      }

      .section-header.is-centered {
        text-align: center;
        justify-items: center;
      }

      .section-header.is-centered h2,
      .section-header.is-centered .subtitle {
        max-width: 28ch;
      }

      .panel {
        border: 1px solid var(--line);
        background: var(--surface);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow);
        padding: 1.2rem;
      }

      .grid {
        display: grid;
        gap: 1rem;
      }

      .grid-4 {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .grid-3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .grid-5 {
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }

      .icon-card {
        border: 1px solid var(--line);
        background: var(--surface);
        border-radius: var(--radius-md);
        padding: 1rem;
        display: grid;
        gap: 0.8rem;
        min-height: 170px;
      }

      .icon-card--soft {
        background: var(--surface-soft);
      }

      .icon-card h3 {
        margin: 0;
        font-size: 1rem;
      }

      .icon-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.45;
        font-size: 0.95rem;
      }

      .icon-badge {
        width: 2.3rem;
        height: 2.3rem;
        border-radius: 0.75rem;
        border: 1px solid #c8d7ea;
        background: var(--primary-soft);
        color: #1955a0;
        display: grid;
        place-items: center;
      }

      .icon-badge svg {
        width: 1.35rem;
        height: 1.35rem;
      }

      .soft-block {
        background: linear-gradient(160deg, #f8fbff 0%, #eef6ff 100%);
        border-top: 1px solid #e1e9f3;
        border-bottom: 1px solid #e1e9f3;
      }

      .steps-wrap {
        padding: 1rem;
        border-radius: var(--radius-lg);
        border: 1px solid var(--line);
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
      }

      .step-card {
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        background: var(--surface);
        padding: 1rem;
        position: relative;
      }

      .step-index {
        width: 1.8rem;
        height: 1.8rem;
        border-radius: 999px;
        display: grid;
        place-items: center;
        border: 1px solid #c8d7ea;
        background: var(--primary-soft);
        color: #134f97;
        font-size: 0.8rem;
        font-weight: 800;
      }

      .step-card h3 {
        margin: 0.8rem 0 0.4rem;
        font-size: 1rem;
      }

      .step-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.45;
        font-size: 0.94rem;
      }

      .why-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.8rem;
      }

      .dev-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 1rem;
        align-items: stretch;
      }

      .dev-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.55rem;
      }

      .dev-list li {
        border: 1px solid var(--line);
        background: var(--surface-soft);
        border-radius: 0.75rem;
        padding: 0.62rem 0.72rem;
        font-weight: 700;
        font-size: 0.91rem;
      }

      .code-card {
        border: 1px solid #c4d4e8;
        background: #0e1b2d;
        color: #dbe7f7;
        border-radius: var(--radius-md);
        padding: 0.95rem;
        font-size: 0.83rem;
        overflow-x: auto;
      }

      .code-card code {
        font-family: "SF Mono", "Menlo", "Consolas", monospace;
        line-height: 1.5;
      }

      .final-cta {
        background:
          radial-gradient(circle at 100% 0, #e9f8f2 0%, transparent 38%),
          radial-gradient(circle at 0 100%, #eaf2ff 0%, transparent 42%),
          #ffffff;
      }

      .final-cta .section-header h2 {
        max-width: 17ch;
      }

      .footer {
        padding: 2rem 0 2.5rem;
      }

      .footer-wrap {
        border-top: 1px solid var(--line);
        padding-top: 1.2rem;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .motion-in {
        transform: none;
        opacity: 1;
      }

      .stagger > * {
        transform: none;
        opacity: 1;
      }

      @media (prefers-reduced-motion: no-preference) {
        .motion-in {
          opacity: 0;
          transform: translateY(14px);
          animation: rise 0.7s ease forwards;
          animation-delay: var(--delay, 0ms);
        }

        .stagger > * {
          opacity: 0;
          transform: translateY(12px);
          animation: rise 0.6s ease forwards;
          animation-delay: calc(var(--item, 0) * 90ms + 120ms);
        }
      }

      @keyframes rise {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 1060px) {
        .hero-grid,
        .dev-grid {
          grid-template-columns: 1fr;
        }

        .hero-visual {
          min-height: 300px;
        }

        .grid-4 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .why-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        .header-nav a:not(.btn) {
          display: none;
        }

        .section {
          padding: 4.1rem 0;
        }

        .hero {
          padding-top: 3.6rem;
        }

        .hero h1 {
          max-width: 14ch;
        }

        .steps,
        .grid-3,
        .grid-4,
        .why-grid {
          grid-template-columns: 1fr;
        }

        .icon-card {
          min-height: auto;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-wrap">
        <div class="brand">Biometric Trust Layer</div>
        <nav class="header-nav" aria-label="Primary navigation">
          <a href="#solution">Solution</a>
          <a href="#how-it-works">How it works</a>
          <a href="#developers">Developers</a>
          <a href="#demo" class="btn btn-secondary">Book demo</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero section">
        <div class="container hero-grid">
          <div class="motion-in" style="--delay: 40ms;">
            <p class="eyebrow">Biometric proof platform</p>
            <h1>Prove identity. Prove humanity.</h1>
            <p class="hero-subtitle">
              Biometric authentication that helps stop bots, fraud and impersonation.
            </p>
            <div class="hero-actions">
              <a href="#demo" class="btn btn-primary">Book demo</a>
              <a href="#how-it-works" class="btn btn-secondary">See how it works</a>
            </div>
            <div class="trust-pills">
              <span class="pill">Post-quantum crypto</span>
              <span class="pill">OpenID compatible</span>
              <span class="pill">Runs in TEE</span>
            </div>
          </div>

          <div class="hero-visual motion-in" style="--delay: 160ms;" aria-hidden="true">
            <svg viewBox="0 0 560 430" fill="none">
              <rect x="70" y="55" width="420" height="300" rx="28" fill="#FFFFFF" stroke="#C9D8EC" />
              <rect x="110" y="95" width="180" height="220" rx="18" fill="#F2F7FF" stroke="#D2E0F2" />
              <circle cx="200" cy="165" r="46" fill="#E8F1FF" stroke="#BDD1EB" />
              <circle cx="184" cy="159" r="5" fill="#2B4E77" />
              <circle cx="216" cy="159" r="5" fill="#2B4E77" />
              <path d="M180 185C186 193 194 197 200 197C206 197 214 193 220 185" stroke="#2B4E77" stroke-width="4" stroke-linecap="round" />
              <rect x="152" y="232" width="96" height="14" rx="7" fill="#DCE8F8" />
              <rect x="152" y="254" width="72" height="14" rx="7" fill="#DCE8F8" />

              <rect x="306" y="95" width="144" height="100" rx="16" fill="#F1FAF6" stroke="#C9EAD8" />
              <path d="M378 120L414 134V163C414 183 400 196 378 208C356 196 342 183 342 163V134L378 120Z" fill="#E5F7EF" stroke="#6BAE8E" stroke-width="2" />
              <path d="M365 163L374 172L392 152" stroke="#2E8661" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />

              <rect x="306" y="215" width="144" height="100" rx="16" fill="#EFF4FF" stroke="#C9D8EC" />
              <rect x="338" y="245" width="80" height="10" rx="5" fill="#CDDDF2" />
              <rect x="338" y="266" width="56" height="10" rx="5" fill="#CDDDF2" />
              <circle cx="420" cy="270" r="10" fill="#0E6FFF" />
            </svg>
          </div>
        </div>
      </section>

      <section class="section" id="problem">
        <div class="container">
          <SectionHeader
            eyebrow="The problem"
            title="Digital actions can be faked in seconds."
            subtitle="Trust breaks when you cannot tell real users from automated or impersonated actors."
          />

          <div class="grid grid-4 stagger">
            {
              problemItems.map((item, index) => (
                <div style={`--item:${index};`}>
                  <IconCard icon={item.icon} title={item.title} text={item.text} />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section soft-block" id="solution">
        <div class="container">
          <SectionHeader
            eyebrow="The solution"
            title="One layer for identity and humanity."
            subtitle="Simple, visual and secure authentication flows for high-trust digital products."
          />

          <div class="grid grid-3 stagger">
            {
              solutionItems.map((item, index) => (
                <div style={`--item:${index};`}>
                  <IconCard icon={item.icon} title={item.title} text={item.text} variant="soft" />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="how-it-works">
        <div class="container">
          <SectionHeader
            eyebrow="How it works"
            title="Proof in 3 simple steps."
            subtitle="Clear user flow. Clear trust signal."
            align="center"
          />

          <div class="steps-wrap">
            <div class="steps stagger">
              {
                steps.map((step, index) => (
                  <div style={`--item:${index};`}>
                    <StepCard step={index + 1} title={step.title} text={step.text} />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="section soft-block" id="use-cases">
        <div class="container">
          <SectionHeader
            eyebrow="Use cases"
            title="Built for trust-critical sectors."
            subtitle="Where user authenticity has direct product and business impact."
          />

          <div class="grid grid-3 stagger">
            {
              useCases.map((item, index) => (
                <div style={`--item:${index};`}>
                  <IconCard icon={item.icon} title={item.title} text={item.text} />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="why-us">
        <div class="container">
          <SectionHeader
            eyebrow="Why us"
            title="Security that stays practical."
            subtitle="Post-quantum, OpenID-compatible and TEE-backed by design."
          />

          <div class="why-grid stagger">
            {
              whyUs.map((item, index) => (
                <div style={`--item:${index};`}>
                  <IconCard icon={item.icon} title={item.title} text={item.text} variant="soft" />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section soft-block" id="developers">
        <div class="container dev-grid">
          <article class="panel motion-in" style="--delay: 20ms;">
            <SectionHeader
              eyebrow="For developers"
              title="Developer-ready integration."
              subtitle="OpenID-compatible flows, TEE runtime and post-quantum template protection."
            />
            <ul class="dev-list">
              {devStack.map((item) => <li>{item}</li>)}
            </ul>
          </article>

          <article class="panel motion-in" style="--delay: 120ms;">
            <p class="eyebrow">Example</p>
            <div class="code-card">
              <code>
                POST /v1/verify<br />
                &#123;<br />
                &nbsp;&nbsp;"user_id": "usr_892",<br />
                &nbsp;&nbsp;"check": ["face_match", "liveness"],<br />
                &nbsp;&nbsp;"openid_flow": true<br />
                &#125;<br /><br />
                =&gt; &#123; "proof": "identity_humanity_verified", "runtime": "tee" &#125;
              </code>
            </div>
          </article>
        </div>
      </section>

      <section class="section" id="demo">
        <div class="container">
          <article class="panel final-cta motion-in" style="--delay: 40ms;">
            <SectionHeader
              eyebrow="Final CTA"
              title="Build trusted digital interactions."
              subtitle="Add biometric proof of identity and humanity to your product."
            />
            <a href="mailto:hello@biometrictrustlayer.com" class="btn btn-primary">Request a demo</a>
          </article>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-wrap">
        <span>Biometric Trust Layer</span>
        <span>Proof of identity and humanity for modern digital products.</span>
      </div>
    </footer>
  </body>
</html>
